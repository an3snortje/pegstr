# --- Blackboard source -------------------------------------------------
BB_BASE_URL=https://aspire.blackboard.com
# login | cookie | ics   (use "ics" if you can get a calendar feed URL - simplest)
BB_AUTH_MODE=ics

# login mode (local Blackboard accounts only, not SSO):
BB_USERNAME=
BB_PASSWORD=

# cookie mode (for SSO logins): paste the Cookie header from your browser dev tools
BB_COOKIE=

# ics mode: Blackboard calendar page -> gear/settings -> "Share calendar" / iCal link
BB_ICS_FEED_URL=

# Window of dates to pull
DAYS_BACK=7
DAYS_FORWARD=180

# --- Outputs ------------------------------------------------------------
ICS_OUTPUT=data/aspire-critical-dates.ics
STATE_FILE=data/state.json
TZ=Africa/Johannesburg

# --- Optional: push into Outlook/M365 via Microsoft Graph ----------------
# Azure app registration with application permission Calendars.ReadWrite
GRAPH_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_USER=andries@durbanoverall.co.za
GRAPH_CALENDAR_NAME=Aspire Blackboard

# --- Optional: notify n8n when dates are added/changed -------------------
N8N_WEBHOOK_URL=
